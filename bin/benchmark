#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

use Rocket\Tests\Benchmark\FrameworkBenchmark;

echo "\033[36m====================================================\033[0m\n";
echo "\033[36m       Rocketphp Micro-Benchmark Suite               \033[0m\n";
echo "\033[36m====================================================\033[0m\n";
echo "PHP Version: " . PHP_VERSION . " (" . PHP_OS . ")\n";
echo "OPcache:     " . (function_exists('opcache_get_status') && opcache_get_status() ? 'Enabled' : 'Disabled (CLI default)') . "\n\n";

$benchmark = new FrameworkBenchmark();
$results = $benchmark->runAll();

printf("%-30s | %-12s | %-15s | %-15s | %-15s\n", "Benchmark Stage", "Iterations", "Total Time (ms)", "Avg Time (µs)", "Ops / Second");
echo str_repeat('-', 95) . "\n";

foreach ($results as $stage => $data) {
    printf(
        "%-30s | %-12s | %-15s | %-15s | %-15s\n",
        str_replace('_', ' ', ucwords($stage, '_')),
        number_format($data['iterations']),
        number_format($data['total_time_ms'], 2) . ' ms',
        number_format($data['avg_time_per_op_us'], 2) . ' µs',
        number_format($data['ops_per_second']) . ' ops/s',
    );
}

echo str_repeat('-', 95) . "\n";
echo "\033[32m✔ Benchmark run completed successfully.\033[0m\n";
